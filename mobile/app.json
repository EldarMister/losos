{
  "expo": {
    "name": "Много лосося",
    "slug": "mnogo-lososya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "mnogolososya",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF4D00"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kg.mnogolososya.mobile"
    },
    "android": {
      "package": "kg.mnogolososya.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#FF4D00"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#FF4D00"
        }
      ],
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/app-icon.png"
    }
  }
}
