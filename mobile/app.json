{
  "expo": {
    "name": "Накта суши",
    "slug": "nakta-sushi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.jpeg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "naktasushi",
    "splash": {
      "image": "./assets/app-icon.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#FF4D00"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kg.naktasushi.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Накта суши использует геопозицию, чтобы быстрее определить адрес доставки и показать ближайшие кухни."
      }
    },
    "android": {
      "package": "kg.naktasushi.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.jpeg",
        "backgroundColor": "#FF4D00"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#FF4D00",
          "defaultChannel": "orders"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Накта суши использует геопозицию, чтобы быстрее определить адрес доставки и показать ближайшие кухни."
        }
      ],
      "expo-dev-client",
      "expo-asset",
      "./plugins/withYandexMapKit"
    ],
    "web": {
      "favicon": "./assets/app-icon.jpeg"
    }
  }
}
