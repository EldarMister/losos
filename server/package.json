{
  "name": "mnogolososya-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "seed": "npm run build && node dist/seed.js",
    "catalog:generate": "tsx ../scripts/generate-server-catalog-seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio",
    "migration:run": "npm run build && typeorm -d dist/data-source.js migration:run",
    "migration:revert": "npm run build && typeorm -d dist/data-source.js migration:revert",
    "test": "tsx --test test/backend.test.ts",
    "test:integration": "npm run build && node test/postgres.integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/node": "^22.18.6",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
